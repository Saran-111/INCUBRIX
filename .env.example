# IncuBrix Long-Tail Distribution Connector Service Configuration

# Service Information
APP_NAME=IncuBrix Long-Tail Distribution Connector Service
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
CONNECTOR_V1_PREFIX=/connector/v1
ENVIRONMENT=development
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Simulation Mode (Must-have 7)
# Set to true to run all connectors against local mocks with zero external API credentials
SIMULATION_MODE=true
MOCK_LATENCY_MS=50
MOCK_FAILURE_RATE=0.0

# HMAC & Security
HMAC_SECRET=incubrix-super-secret-hmac-key-for-testing-only
WEBHOOK_SIGNATURE_HEADER=X-IncuBrix-Signature

# Storage (S3 / MinIO or Local filesystem)
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./storage_data
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=incubrix-artifacts
S3_REGION=us-east-1

# External Platform Base URLs (or local instances)
LEMMY_BASE_URL=http://localhost:8536
GHOST_BASE_URL=http://localhost:2368
DISCOURSE_BASE_URL=http://localhost:4200
DEVTO_BASE_URL=https://dev.to/api
HASHNODE_BASE_URL=https://gql.hashnode.com
SLACK_BASE_URL=https://slack.com/api
MAILCHIMP_BASE_URL=https://us1.api.mailchimp.com/3.0

# Posting Rules Defaults
FREQUENCY_CAP_WINDOW_HOURS=24
MAX_POSTS_PER_WINDOW=1
AUTO_DELETE_MAX_MINUTES=10
